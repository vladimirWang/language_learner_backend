# 环境变量示例：复制为 deploy/.env.dev 后填入真实值（.env.dev 不入库）
# ---- 公共 ----
APP_ENV=dev
LOG_LEVEL=debug
LISTEN_ADDR=:8080

# ---- 生产镜像仓库（docker-compose.prod.yml 的变量替换，不填则用本地镜像默认值）----
# 私有仓库需先在服务器执行 docker login；回滚时把 IMG_SERVICE 改成对应时间戳 tag
IMG_SERVICE=docker.io/furchtlos/lang-service:prod
IMG_NGINX=docker.io/furchtlos/lang-nginx:prod
IMG_PG=docker.io/furchtlos/lang-pg:pg17
IMG_MIGRATE=docker.io/furchtlos/lang-migrate:v4.18.3

# ---- PostgreSQL（dev：复用外部 PG，端口映射见 infra compose 的 15432）----
PG_HOST=host.docker.internal
PG_PORT=15432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=lang_learning_dev
PG_MAX_CONNS=4

# ---- 对象存储（dev 默认留空：产物保留在 /builder/work）----
S3_ENDPOINT=
S3_BUCKET=lang-learning-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- 外部 Embedding API ----
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH=10

# ---- RabbitMQ（PDF 试卷异步解析）----
RABBITMQ_URL=amqp://root:1234@host.docker.internal:5672/
PDF_IMPORT_QUEUE=pdf.import

# ---- Redis（连续签到 bitmap，与 PostgreSQL 同网络，端口 16379）----
REDIS_ADDR=host.docker.internal:16379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 构建任务保护 ----
BUILD_MAX_PARALLEL=1
MIN_AVAILABLE_MEM_MB=120

# ---- Python / uv ----
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_CACHE_DIR=/builder/.uv-cache

# ---- 听力解析入口 ----
# 留空：使用 Python（uv run --no-sync python -m builder.listen）
# 镜像内已内置 /usr/local/bin/listen-parser；填写下面这行即切换为独立二进制
# 注意：自定义路径时必须确认该路径在运行环境（容器内/主机）真实存在，否则听力导入会直接失败
# LISTEN_BIN=/usr/local/bin/listen-parser

# ---- 素材仓库 ----
REPO_DE_URL=
REPO_EN_URL=
REPO_JA_URL=

# ---- 管理台 SSO 登录（OAuth2 授权码）----
# 服务端访问 SSO auth-api 的地址；容器内通常为 http://host.docker.internal:8888
SSO_BASE_URL=
# 浏览器访问 SSO 登录页的地址（nginx/Vite 托管的 SPA 网关，不是 auth-api 的 8888）
# 本地开发：http://127.0.0.1；生产：https://sso.example.com
SSO_PUBLIC_BASE_URL=
SSO_CLIENT_ID=language-learner-admin
SSO_CLIENT_SECRET=
# 必须与 SSO oauth_clients.redirect_uris 完全一致
SSO_REDIRECT_URI=http://localhost:5173/sso/callback
# 仅本地开发：true 时跳过真实 SSO，固定返回 SSO_DEV_MOCK_EMAIL 账号；生产必须为 false
SSO_DEV_MOCK=false
SSO_DEV_MOCK_EMAIL=413114463@qq.com

# ---- 每日新词接口（客户端 / 豆包插件）----
# 留空时 /api/daily-words 与 /api/daily-words/learned 返回 503；调用方需带 X-API-Key
DAILY_WORDS_API_KEY=
# 每 IP 每分钟请求上限；0 表示不限制（多实例部署时为近似限流）
DAILY_WORDS_RATE_LIMIT=60
# 每日分配、最近五天新词及每日关卡日期门槛使用的时区
APP_TZ=Asia/Shanghai
# 每日关卡生成时刻（HH:mm），启动时补当天与次日，之后定时生成次日。
# 生成时间不等于学员可见时间：提前生成的关卡仍到对应日期 00:00（APP_TZ）才可见、可提交。
DAILY_CHALLENGE_GENERATE_AT=00:05

# ---- LLM / ASR / 搜索 ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ASR_MODEL=
# 口语朗读 TTS：留空则复用 DASHSCOPE_API_KEY 并使用默认模型/音色（支持德语）
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 微信小程序一键登录：在微信公众平台「开发管理 → 开发设置」获取 AppID/AppSecret
# TokenSecret 自定义一个长随机串用于签发登录态；三项留空则登录接口返回 503
WX_APPID=
WX_APPSECRET=
WX_TOKEN_SECRET=
# ---- 学员端多语种配置 ----
# 请求未带 lang 时使用的缺省语种；小程序端当前固定为 de
DEFAULT_LANG=de
# 服务端允许的语种集合（逗号分隔）。新增语种时在此追加，并配置对应 REPO_<LANG>_URL
SUPPORTED_LANGS=de,en,ja
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=
