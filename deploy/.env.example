# 环境变量示例：复制为 deploy/.env.dev 后填入真实值（.env.dev 不入库）
# ---- 公共 ----
APP_ENV=dev
LOG_LEVEL=debug
LISTEN_ADDR=:8080

# ---- PostgreSQL（dev：复用外部 PG，端口映射见 infra compose 的 15432）----
PG_HOST=host.docker.internal
PG_PORT=15432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=lang_learning_dev
PG_MAX_CONNS=4

# ---- 对象存储（dev 默认留空：产物保留在 /builder/work）----
S3_ENDPOINT=
S3_BUCKET=lang-learning-dev
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- 外部 Embedding API ----
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_BATCH=10

# ---- RabbitMQ（PDF 试卷异步解析）----
RABBITMQ_URL=amqp://root:1234@host.docker.internal:5672/
PDF_IMPORT_QUEUE=pdf.import

# ---- 构建任务保护 ----
BUILD_MAX_PARALLEL=1
MIN_AVAILABLE_MEM_MB=120

# ---- Python / uv ----
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
UV_CACHE_DIR=/builder/.uv-cache

# ---- 素材仓库 ----
REPO_DE_URL=
REPO_EN_URL=
REPO_JA_URL=

# ---- LLM / ASR / 搜索 ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ASR_MODEL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=
