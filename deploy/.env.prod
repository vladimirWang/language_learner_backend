APP_ENV=prod
LOG_LEVEL=info
LISTEN_ADDR=:8080

# ---- PostgreSQL（prod：compose 内独立 PG + pgBouncer）----
PG_HOST=postgres
PG_PORT=5432
PG_USER=lang_app
PG_PASSWORD=${PG_PASSWORD}
PG_DATABASE=lang_learning
PG_MAX_CONNS=4

# ---- 对象存储 ----
S3_ENDPOINT=${S3_ENDPOINT}
S3_BUCKET=lang-learning
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}

# ---- 外部 Embedding API ----
EMBEDDING_API_URL=${EMBEDDING_API_URL}
EMBEDDING_API_KEY=${EMBEDDING_API_KEY}
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH=32

# ---- 构建任务保护 ----
BUILD_MAX_PARALLEL=1
MIN_AVAILABLE_MEM_MB=120

# ---- Python / uv ----
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# ---- 素材仓库（用于监听变更）----
REPO_DE_URL=${REPO_DE_URL}
REPO_EN_URL=${REPO_EN_URL}
REPO_JA_URL=${REPO_JA_URL}

# ---- 每日新词接口 ----
DAILY_WORDS_API_KEY=${DAILY_WORDS_API_KEY}
DAILY_WORDS_RATE_LIMIT=60
APP_TZ=Asia/Shanghai

# ---- 管理台 SSO 登录 ----
SSO_BASE_URL=${SSO_BASE_URL}
SSO_PUBLIC_BASE_URL=${SSO_PUBLIC_BASE_URL}
SSO_CLIENT_ID=language-learner-admin
SSO_CLIENT_SECRET=${SSO_CLIENT_SECRET}
SSO_REDIRECT_URI=${SSO_REDIRECT_URI}
